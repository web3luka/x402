# x402-hono server example env
# Copy to .env and adjust values

# --- General ---
PORT=4021

# --- EVM verification ---
# Strict mode by default (recommended for prod)
X402_RELAXED_TXID_ONLY=0
EVM_FINALITY=12

# Optional RPC overrides (dev-friendly defaults exist in code)
# BSC_RPC_PRIMARY=https://rpc.ankr.com/bsc
# BSC_RPC_FALLBACK_1=
# BSC_RPC_FALLBACK_2=
# BSC_TESTNET_RPC_PRIMARY=https://rpc.ankr.com/bsc_testnet
# BSC_TESTNET_RPC_FALLBACK_1=
# BSC_TESTNET_RPC_FALLBACK_2=

# --- TON ---
# Optional: TONAPI key for better limits
# TONAPI_KEY=

# --- Idempotency (Redis) ---
# When not set, in-memory Set is used
# REDIS_URL=redis://localhost:6379
# X402_IDEM_NAMESPACE=x402:used_txids

# --- Rate limiting ---
# Sliding window per IP
X402_RATE_WINDOW_MS=10000
X402_RATE_MAX=30
